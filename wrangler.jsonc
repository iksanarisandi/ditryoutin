{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tryout-upkp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tryout-upkp-db",
      "database_id": "cce67d3f-0dc7-4a20-9988-b6ceaa7b59b7",
      "migrations_dir": "migrations"
    }
  ],
  // Penyimpanan PDF materi bacaan. Bucket "tryout-upkp-materi" harus dibuat
  // dulu sekali lewat `npx wrangler r2 bucket create tryout-upkp-materi`
  // sebelum deploy (wrangler dev mensimulasikannya lokal otomatis).
  "r2_buckets": [
    {
      "binding": "MATERI_BUCKET",
      "bucket_name": "tryout-upkp-materi"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Bukan rahasia — boleh di config. Nilai di sini hanya BASELINE: dipakai bila
  // mode belum pernah diubah dari panel admin (Admin → Transaksi → Mode Pembayaran
  // & Gateway Aktif, tersimpan di tabel settings D1 dan menimpa env — tanpa deploy ulang).
  // "gateway" = gateway otomatis (QRIS dinamis, Pakasir/Duitku); "manual" = QRIS pribadi + WA.
  // 2026-10-08: baseline kembali "gateway" (Pakasir pulih; nilai lama "pakasir"
  // di-rename "gateway" oleh migration 0015 — alias lama tetap diterima kode).
  // MANUAL_WA tetap dipakai sebagai kontak kendala pembayaran di halaman bayar.
  // SHOW_MANUAL_PAYMENT "true" = tampilkan lagi tombol Bayar Manual (fallback).
  //
  // Duitku (gateway alternatif QRIS): kredensial PRODUKSI terpasang sejak
  // 2026-10-12 (review Duitku lolos; smoke --prod: signature OK, akun aktif,
  // tapi baru BRI VA — channel QRIS menunggu aktivasi di sisi Duitku, sampai
  // itu fallback duitku gagal "Payment channel not available").
  // 2026-10-14: QRIS NusaPay AKTIF — kodenya "SQ" di API produksi (bukan "NQ"
  // seperti di sandbox; NQ/SP ditolak "Payment channel not available").
  // Urutan "SQ,NQ,SP": SQ dipakai dulu, NQ/SP fallback otomatis bila kelak
  // ikut aktif di merchant (daftar channel aktif: lihat getpaymentmethod di
  // scripts/duitku-smoke.mjs).
  // DUITKU_QRIS_METHOD = daftar preferensi channel: create memakai channel
  // pertama yang tersedia — aktifkan/matikan channel di dashboard Duitku
  // tanpa perlu deploy ulang; balik urutan untuk mengutamakan channel lain.
  // - DUITKU_API_KEY = RAHASIA (key produksi via wrangler secret), JANGAN di sini.
  // - Uji sandbox ke depannya lewat localhost (.dev.vars) — workers_dev sudah
  //   dimatikan pasca-review sehingga preview *.workers.dev tidak ada lagi.
  "vars": {
    "PAYMENT_MODE": "gateway",
    "SHOW_MANUAL_PAYMENT": "false",
    "MANUAL_WA": "6282347303153",
    "ACTIVE_GATEWAY": "pakasir",
    "DUITKU_MERCHANT_CODE": "D25142",
    "DUITKU_SANDBOX": "false",
    "DUITKU_QRIS_METHOD": "SQ,NQ,SP"
  },
  "workers_dev": false,
  // Rate limiter via Durable Object (binding "ratelimit" bawaan tidak enforce
  // pada akun ini). Batasan limit ada di kode: src/middleware/ratelimit.ts.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMIT_DO", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Bersihkan session kedaluwarsa harian (03:17 WIB = 20:17 UTC).
  "triggers": {
    "crons": ["17 20 * * *"]
  },
  "routes": [
    { "pattern": "ditryout.in", "custom_domain": true },
    { "pattern": "www.ditryout.in", "custom_domain": true }
  ]
}
