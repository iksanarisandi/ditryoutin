# Salin file ini menjadi .dev.vars untuk pengembangan lokal.
# .dev-vars DI-IGNORE GIT dan TIDAK BOLEH di-commit.

# Pakasir (dari halaman detail Proyek di https://app.pakasir.com)
PAKASIR_API_KEY=
PAKASIR_PROJECT=
# Secret validasi header X-Secret webhook Pakasir (lihat bawah halaman detail proyek)
PAKASIR_WEBHOOK_SECRET=

# Secret acak untuk derivasi hash sesi (generate: openssl rand -hex 32)
SESSION_SECRET=

# Opsional: mengunci halaman /setup dengan secret tambahan (wajib untuk production)
SETUP_SECRET=

# Cloudflare Turnstile (SANGAT DISARANKAN produksi) — anti-bot register/login.
# Buat widget di dashboard Cloudflare: Turnstile -> Add site (mode Managed).
# SITE_KEY boleh publik (dipakai frontend); SECRET_KEY jangan bocor.
# Jika keduanya kosong, captcha nonaktif (register hanya dilindungi rate limit).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — pengirim email reset password (dashboard.resend.com -> API Keys).
# Rahasia: di produksi set via `wrangler secret put RESEND_API_KEY` atau
# dashboard Cloudflare, bukan di git. Domain pengirim noreply@ditryout.in
# harus berstatus Verified di Resend agar email tidak ditolak.
RESEND_API_KEY=

# Mode pembayaran BUKAN rahasia — diatur di wrangler.jsonc bagian "vars":
#   PAYMENT_MODE=gateway -> gateway otomatis (Pakasir/Duitku sesuai ACTIVE_GATEWAY)
#   PAYMENT_MODE=manual  -> QRIS pribadi (/public/img/qris.jpg) + verifikasi admin via WA
#   SHOW_MANUAL_PAYMENT=true -> tampilkan tombol Bayar Manual (fallback gateway)

# Duitku SANDBOX (gateway alternatif QRIS) — dashboard sandbox.duitku.com.
# API key sandbox untuk uji lokal; key produksi (passport.duitku.com) hanya
# via `wrangler secret put DUITKU_API_KEY`. Callback Duitku tidak terjangkau
# dari localhost — alur lokal tuntas lewat polling status.
# Set ACTIVE_GATEWAY=duitku untuk memaksa uji Duitku (fallback tetap pakasir).
# DUITKU_FEE_PCT (default ambil wrangler.jsonc): fee QRIS % yang di-pass-
# through ke pembeli via gross-up nominal — kosongkan untuk tanpa markup.
DUITKU_API_KEY=
DUITKU_MERCHANT_CODE=
DUITKU_SANDBOX=true
ACTIVE_GATEWAY=pakasir
